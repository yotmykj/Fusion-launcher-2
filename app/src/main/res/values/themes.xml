<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme — Compose handles all visual theming.
        We set NoActionBar so Compose can own the full window.
    -->
    <style name="Theme.FusionLauncher" parent="@android:style/Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
